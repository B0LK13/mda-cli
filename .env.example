# Copy to .env and fill in values (never commit .env).
# PowerShell: copy .env.example .env
# bash: cp .env.example .env

# --- API keys (at least one required for live runs) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Provider selection ---
# MDA_PROVIDER=anthropic
# MDA_USE_OPENROUTER=0
# MDA_OPENROUTER_MODEL=anthropic/claude-sonnet-4
# MDA_OPENROUTER_FALLBACK=1

# --- Model and limits ---
# MDA_MODEL=claude-sonnet-4-20250514
# MDA_MAX_TOKENS=8192
# MDA_MAX_RETRIES=3
# MDA_API_TIMEOUT=600

# --- Skill and inputs ---
# MDA_SKILL=markdown-document-architect
# MDA_SKILL_DIR=
# MDA_EXTENSIONS=.md,.txt,.pdf,.docx

# --- Cost guardrails (CLI also supports --max-files / --max-tokens) ---
# Use --max-files on directory batches to cap file count before API calls.
# Use --max-tokens to cap output tokens per file.

# --- Windows installer override (optional) ---
# MDA_PYTHON=C:\Path\To\python.exe
